# ─────────────────────────────────────────────────────────────────────────────
# ClinicTec — Plantilla de variables de entorno del backend
# Copia este archivo como ".env" y completa los valores reales.
#   cp .env.example .env
# NUNCA subas ".env" al repositorio Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos PostgreSQL en Supabase ──────────────────────────────────────
# Formato: postgresql+psycopg2://usuario:contraseña@host:5432/nombre_bd
# Encuéntralo en Supabase → Settings → Database → Connection string → URI
# IMPORTANTE: usa el puerto 5432 (Transaction pooler no es compatible con SQLAlchemy).
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una clave aleatoria con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga

# Entorno: development | production | testing
FLASK_ENV=development

# ── JWT (fase 4) ─────────────────────────────────────────────────────────────
# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=548bcdc8ff7d70fe910ad9b54c1a9bfe55c0658b1ec14490f925761c6b787890

# Duración del access token en minutos (default: 60)
JWT_ACCESS_MINUTES=60

# Duración del refresh token en días (default: 7)
JWT_REFRESH_DAYS=7
